<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.beauty.RegisterController"
      alignment="CENTER"
      spacing="12"
      prefWidth="460"
      styleClass="root-pane">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Реєстрація"
           styleClass="title-label"/>

    <TextField fx:id="usernameField"
               promptText="Ім'я користувача"/>

    <TextField fx:id="phoneField"
               promptText="Номер телефону"/>

    <TextField fx:id="emailField"
               promptText="Електронна пошта"/>

    <PasswordField fx:id="passwordField"
                   promptText="Пароль"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Підтвердження пароля"/>

    <Label fx:id="errorLabel"
           wrapText="true"/>

    <HBox spacing="10" alignment="CENTER">

        <Button text="Назад"
                onAction="#onBackToLogin"
                styleClass="secondary-button"/>

        <Button text="Зареєструватися"
                onAction="#onRegister"
                styleClass="primary-button"/>

    </HBox>

</VBox>
